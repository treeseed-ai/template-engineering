{
  "schemaVersion": 1,
  "id": "engineering",
  "displayName": "TreeSeed Engineering",
  "description": "First-party TreeSeed starter for integrated software guidance, docs, and engineering agents.",
  "category": "starter",
  "tags": [
    "starter",
    "engineering",
    "software",
    "agents",
    "docs"
  ],
  "templateVersion": "1.0.0-rc.2",
  "templateApiVersion": 1,
  "projectKind": "application",
  "platformProfile": "engineering",
  "repositoryVisibility": [
    "public",
    "private"
  ],
  "minCliVersion": "0.1.1",
  "minCoreVersion": "0.1.2",
  "variables": [
    {
      "name": "Site name",
      "token": "__SITE_NAME__",
      "deriveFrom": "name",
      "required": true
    },
    {
      "name": "Site slug",
      "token": "__SITE_SLUG__",
      "deriveFrom": "slug",
      "required": true
    },
    {
      "name": "Site URL",
      "token": "__SITE_URL__",
      "deriveFrom": "siteUrl",
      "default": "https://example.com",
      "required": true
    },
    {
      "name": "Contact email",
      "token": "__CONTACT_EMAIL__",
      "deriveFrom": "contactEmail",
      "default": "hello@example.com",
      "required": true
    },
    {
      "name": "Repository URL",
      "token": "__REPOSITORY_URL__",
      "deriveFrom": "repositoryUrl",
      "default": "https://github.com/example/software"
    },
    {
      "name": "Discord URL",
      "token": "__DISCORD_URL__",
      "deriveFrom": "discordUrl",
      "default": "https://discord.gg/example"
    }
  ],
  "dependencyRelease": {
    "agent": "0.13.0-rc.41",
    "cli": "0.13.0-rc.45",
    "core": "0.12.60-rc.8",
    "sdk": "0.13.0-rc.67"
  },
  "managedSurface": {
    "coreManaged": [
      "package.json",
      "astro.config.ts",
      "tsconfig.json",
      "treeseed.site.yaml",
      "src/content.config.ts",
      "src/content/config.ts",
      "src/config.yaml",
      "src/manifest.yaml",
      "src/env.yaml"
    ],
    "validatedOnly": [
      "treeseed.site.yaml",
      "src/config.yaml",
      "src/manifest.yaml",
      "src/env.yaml"
    ]
  },
  "testing": {
    "buildCommand": "npm run build"
  }
}
